# Playwright MCP auto-captured snapshots and console logs
.playwright-mcp/*.yml
.playwright-mcp/*.log
# Generated per-step chat scripts (made from t/tpl.js)
.playwright-mcp/t/[a-z].js
.playwright-mcp/t/x*.js
# Ad-hoc helper scripts created during test runs (reports .md are still tracked)
.playwright-mcp/t/*.js
.playwright-mcp/t/*.sh
!.playwright-mcp/t/tpl.js
!.playwright-mcp/t/reset.js
